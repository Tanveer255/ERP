# Dev: leave empty to use the Vite proxy (recommended — avoids CORS/cookie issues).
VITE_API_URL=

# Backend URL for the Vite dev proxy (monolith mode).
VITE_API_PROXY_TARGET=https://localhost:7013

# API mode: monolith (default) | gateway (Enterprise microservices via YARP)
VITE_API_MODE=monolith

# Gateway mode: point proxy at the API Gateway instead, e.g.:
# VITE_API_PROXY_TARGET=http://localhost:5000
# VITE_API_MODE=gateway

# Production build: set the public API URL instead, e.g.:
# VITE_API_URL=https://localhost:7013
